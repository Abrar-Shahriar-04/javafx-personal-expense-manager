<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.javafxpersonalexpensemanager.ExpenseController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Personal Expense Tracker" />

    <!-- Input Form Grid -->
    <GridPane hgap="10" vgap="10">
        <Label text="Title:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <TextField fx:id="titleField" promptText="e.g., Grocery" GridPane.columnIndex="1" GridPane.rowIndex="0" />

        <Label text="Amount ($):" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <TextField fx:id="amountField" promptText="e.g., 45.50" GridPane.columnIndex="1" GridPane.rowIndex="1" />

        <Label text="Category:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <ComboBox fx:id="categoryComboBox" prefWidth="175.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />

        <Label text="Date:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
        <DatePicker fx:id="datePicker" prefWidth="175.0" GridPane.columnIndex="1" GridPane.rowIndex="3" />

        <Button fx:id="addButton" onAction="#handleAddExpense" text="Add Expense" GridPane.columnIndex="1" GridPane.rowIndex="4" />
        <columnConstraints>
            <ColumnConstraints />
            <ColumnConstraints />
        </columnConstraints>
        <rowConstraints>
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
        </rowConstraints>
    </GridPane>

    <!-- TableView to display expenses -->
    <TableView fx:id="expenseTable" prefHeight="200.0" prefWidth="400.0">
        <columns>
            <TableColumn fx:id="titleColumn" prefWidth="120.0" text="Title" />
            <TableColumn fx:id="amountColumn" prefWidth="90.0" text="Amount ($)" />
            <TableColumn fx:id="categoryColumn" prefWidth="100.0" text="Category" />
            <TableColumn fx:id="dateColumn" prefWidth="90.0" text="Date" />
        </columns>
    </TableView>

    <!-- Total Display -->
    <HBox spacing="10">
        <Label style="-fx-font-weight: bold; -fx-font-size: 14px;" text="Total Expenses:" />
        <Label fx:id="totalLabel" style="-fx-font-weight: bold; -fx-font-size: 14px;" text="\$0.00" />
    </HBox>
</VBox>